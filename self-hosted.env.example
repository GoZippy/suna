# Self-Hosted Suna Environment Configuration
# Copy this file to .env and customize the values for your deployment

# Database Configuration
POSTGRES_PASSWORD=your_super_secure_postgres_password_here
DATABASE_URL=postgresql://suna:your_super_secure_postgres_password_here@postgres:5432/suna

# JWT Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_to_a_long_random_string

# Admin User Configuration
ADMIN_EMAIL=admin@suna.local
ADMIN_PASSWORD=your_admin_password_change_this

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=False

# Email Configuration (Optional - uses MailHog by default)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# CORS Configuration
CORS_ORIGINS=["http://localhost:18884", "http://127.0.0.1:18884"]

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=production

# Monitoring (Optional)
GRAFANA_PASSWORD=your_grafana_admin_password

# AI/ML Configuration (Optional)
# Ollama will be available at http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434

# External LLM API Keys (Optional - for fallback when local models aren't available)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# File Storage Configuration
# For local file storage, files will be stored in Docker volumes
MAX_UPLOAD_SIZE=100MB
FILE_STORAGE_PATH=/data/files

# Usage and Billing Configuration
DEFAULT_FREE_CREDITS=10
DEFAULT_PRO_CREDITS=50
DEFAULT_ENTERPRISE_CREDITS=100

# Security Settings
SESSION_TIMEOUT_MINUTES=480  # 8 hours
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Sandbox Configuration
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_COUNT=2
SANDBOX_TIMEOUT_SECONDS=300

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Backup Configuration (Optional)
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# Monitoring and Alerting
PROMETHEUS_RETENTION=200h
GRAFANA_ADMIN_USER=admin

# Network Configuration
INTERNAL_NETWORK=suna-network
EXTERNAL_DOMAIN=suna.local

# SSL Configuration (for production)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Resource Limits
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
REDIS_MAX_MEMORY=8gb

# Feature Flags
ENABLE_WEB_SEARCH=true
ENABLE_FILE_UPLOAD=true
ENABLE_SANDBOX_EXECUTION=true
ENABLE_AI_MODELS=true
ENABLE_MONITORING=true
ENABLE_EMAIL_NOTIFICATIONS=true

