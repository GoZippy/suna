{
  "name": "suna-frontend-tests",
  "version": "1.0.0",
  "description": "Frontend test suite for Suna AI Worker",
  "scripts": {
    "test": "vitest",
    "test:unit": "vitest run --reporter=verbose tests/unit/",
    "test:components": "vitest run --reporter=verbose tests/components/",
    "test:integration": "vitest run --reporter=verbose tests/integration/",
    "test:a11y": "vitest run --reporter=verbose tests/accessibility/",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@vitejs/plugin-react": "^4.0.4",
    "@vitest/coverage-v8": "^0.34.6",
    "@vitest/ui": "^0.34.6",
    "jsdom": "^22.1.0",
    "vitest": "^0.34.6"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}







