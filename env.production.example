# Production Environment Variables
# Copy this file to .env.production and update with your values

# Database Configuration
POSTGRES_PASSWORD=suna_secure_password_change_this
DATABASE_URL=postgresql://suna:suna_secure_password_change_this@postgres:5432/suna

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6391
REDIS_PASSWORD=
REDIS_SSL=False

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# Admin Configuration
ADMIN_EMAIL=admin@suna.local
ADMIN_PASSWORD=admin_secure_password_change_this

# SMTP Configuration
SMTP_HOST=mailhog
SMTP_PORT=1091
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SENDER_EMAIL=noreply@suna.local
SENDER_NAME=Suna System

# Application Configuration
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3091", "http://127.0.0.1:3091", "http://suna.local:3091"]

# Feature Flags
ENABLE_LOCAL_EMAIL=true
ENABLE_EMAIL_QUEUE=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_BACKGROUND_JOBS=true
ENABLE_JOB_SCHEDULING=true
ENABLE_JOB_MONITORING=true
ENABLE_WORKER_SCALING=true
ENABLE_JOB_PERSISTENCE=true
ENABLE_WEBSOCKET=true
ENABLE_FILE_STORAGE=true
ENABLE_MONITORING=true
ENABLE_METRICS_COLLECTION=true
ENABLE_HEALTH_CHECKS=true
ENABLE_ALERTING=true
ENABLE_AUDIT_LOGGING=true

# Storage Configuration
LOCAL_STORAGE_PATH=/app/data/storage

# Worker Configuration
WORKER_PROCESSES=4
WORKER_THREADS=4

# Monitoring Configuration
GRAFANA_PASSWORD=admin_secure_password_change_this

# LLM API Keys (for fallback to external services)
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Search API Keys
TAVILY_API_KEY=your_tavily_api_key
RAPID_API_KEY=your_rapid_api_key
FIRECRAWL_API_KEY=your_firecrawl_api_key

# AWS Configuration (for Bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION_NAME=us-east-1

# Daytona Configuration (if using external sandbox)
DAYTONA_API_KEY=your_daytona_api_key
DAYTONA_SERVER_URL=https://your-daytona-server.com
DAYTONA_TARGET=your_daytona_target

# LangFuse Configuration (for observability)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Admin API Key
KORTIX_ADMIN_API_KEY=your_admin_api_key

# API Key System
API_KEY_SECRET=your_api_key_secret_change_this
API_KEY_LAST_USED_THROTTLE_SECONDS=900

# Agent Limits
MAX_PARALLEL_AGENT_RUNS=3







